{
  "name": "@cogito.ai/template-mobile-expo-thefoolai",
  "version": "0.1.0",
  "private": true,
  "description": "TheFoolAI-specific Expo mobile Agent Host template with Agent Core Lite, voice-first interaction, NativeWind, structured results, and local SQLite persistence.",
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "build": "expo export --platform ios",
    "check": "expo install --check && tsc --noEmit && pnpm build",
    "check-types": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "agentdock": {
    "minCliVersion": "0.28.0",
    "packageManagerEnforced": true,
    "dataLayers": [
      "sqlite"
    ],
    "defaultDataLayer": "sqlite",
    "supportsSchema": false
  },
  "dependencies": {
    "@expo/ui": "57.0.25",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@openuidev/react-lang": "1.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~57.0.30",
    "expo-router": "57.0.28",
    "expo-speech-recognition": "57.1.0",
    "expo-sqlite": "57.0.4",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.61.0",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css-interop": "0.2.7",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.3",
    "@types/react": "~19.2.18",
    "tailwindcss": "3.4.17",
    "typescript": "~6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
