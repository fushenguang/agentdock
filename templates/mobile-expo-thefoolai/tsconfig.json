{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["nativewind/types"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "app/**/*.tsx",
    "app/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.ts",
    "agent/**/*.json",
    "nativewind-env.d.ts"
  ]
}
