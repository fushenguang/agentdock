# sqlite (default) or supabase
DATA_PROVIDER={{DATA_LAYER}}

# SQLite connection used when DATA_PROVIDER=sqlite
SQLITE_DATABASE_URL=./data/app.db

# Supabase Postgres connection used when DATA_PROVIDER=supabase
# Use the transaction pooler connection string when applicable.
SUPABASE_DATABASE_URL=postgres://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:6543/postgres
