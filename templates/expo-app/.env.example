# OpenAI-compatible chat-completions provider. Leave empty to use the local reference driver.
# EXPO_PUBLIC_* values are embedded in the JS bundle: use them for local acceptance only.
# Production calls must go through a server-side proxy instead of shipping an API key.
EXPO_PUBLIC_AGENT_BASE_URL=
EXPO_PUBLIC_AGENT_API_KEY=
EXPO_PUBLIC_AGENT_MODEL=
