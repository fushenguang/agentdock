{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thefoolai.local/schemas/agent-result-1.0.json",
  "title": "Agent result envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "title", "generated_at", "result", "follow_ups"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "status": { "enum": ["ok", "needs-confirmation", "error"] },
    "title": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "follow_ups": { "type": "array", "items": { "type": "string" } },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text"],
          "properties": {
            "kind": { "const": "text" },
            "text": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "metrics"],
          "properties": {
            "kind": { "const": "summary" },
            "metrics": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "value"],
                "properties": {
                  "label": { "type": "string", "minLength": 1 },
                  "value": { "type": ["string", "number"] },
                  "delta": { "type": "string" },
                  "state": { "enum": ["neutral", "positive", "warning", "negative"] }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "table"],
          "properties": {
            "kind": { "const": "table" },
            "table": { "$ref": "#/$defs/table" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "source"],
          "properties": {
            "kind": { "const": "openui" },
            "source": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "message", "confirmLabel", "cancelLabel"],
          "properties": {
            "kind": { "const": "action-request" },
            "message": { "type": "string", "minLength": 1 },
            "confirmLabel": { "type": "string", "minLength": 1 },
            "cancelLabel": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  },
  "$defs": {
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "rows"],
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "label"],
            "properties": {
              "key": { "type": "string" },
              "label": { "type": "string" }
            }
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": {
              "type": ["string", "number", "boolean", "null"]
            }
          }
        }
      }
    }
  }
}
