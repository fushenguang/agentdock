{
  "name": "@cogito.ai/template-web-tanstackstart",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone TanStack Start + Astryx/StyleX + Drizzle starter with SQLite by default and Supabase Postgres as an alternate data source.",
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:prepare && vite dev --host --port 3000 --strictPort",
    "dev:prepare": "node scripts/prepare-dev-db.mjs",
    "start": "node --env-file-if-exists=.env server.mjs",
    "build": "pnpm generate-routes && vite build",
    "preview": "vite preview --host --port 3000 --strictPort",
    "generate-routes": "tsr generate",
    "check-types": "pnpm generate-routes && tsc --noEmit",
    "lint": "pnpm generate-routes && oxlint --type-aware .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm lint && pnpm check-types && pnpm test && pnpm build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:generate:supabase": "drizzle-kit generate --config=drizzle.supabase.config.ts",
    "db:migrate:supabase": "drizzle-kit migrate --config=drizzle.supabase.config.ts"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.5",
    "@astryxdesign/theme-butter": "^0.7.5",
    "@astryxdesign/theme-matcha": "^0.7.5",
    "@astryxdesign/theme-neutral": "^0.7.5",
    "@astryxdesign/theme-stone": "^0.7.5",
    "@stylexjs/stylex": "^0.19.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "postgres": "^4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "srvx": "^1.0.8"
  },
  "devDependencies": {
    "@astryxdesign/build": "^0.7.5",
    "@astryxdesign/cli": "^0.7.5",
    "@babel/core": "^8.1.0",
    "@stylexjs/babel-plugin": "^0.19.1",
    "@stylexjs/unplugin": "^0.19.1",
    "@tanstack/router-cli": "^1.167.46",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "drizzle-kit": "^0.31.11",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.34.5 <13"
  },
  "agentdock": {
    "minCliVersion": "0.21.0",
    "packageManagerEnforced": true,
    "dataLayers": [
      "sqlite",
      "supabase"
    ],
    "defaultDataLayer": "sqlite",
    "supportsSchema": false,
    "workspaceMember": {
      "rootAllowBuilds": {
        "@astryxdesign/cli": true,
        "@astryxdesign/core": true,
        "better-sqlite3": false,
        "esbuild": true,
        "lightningcss": true
      }
    }
  }
}
