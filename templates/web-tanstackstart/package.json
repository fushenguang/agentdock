{
  "name": "@cogito.ai/template-web-tanstackstart",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone TanStack Start + Astryx/StyleX + Drizzle starter with SQLite by default and Supabase Postgres as an alternate data source.",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host --port 3000 --strictPort",
    "start": "node --env-file-if-exists=.env server.mjs",
    "build": "pnpm generate-routes && vite build",
    "preview": "vite preview --host --port 3000 --strictPort",
    "generate-routes": "tsr generate",
    "check-types": "pnpm generate-routes && tsc --noEmit",
    "lint": "pnpm generate-routes && oxlint --type-aware .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm lint && pnpm check-types && pnpm test && pnpm build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:generate:supabase": "drizzle-kit generate --config=drizzle.supabase.config.ts",
    "db:migrate:supabase": "drizzle-kit migrate --config=drizzle.supabase.config.ts"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.6.0",
    "@astryxdesign/theme-neutral": "^0.6.0",
    "@stylexjs/stylex": "^0.19.0",
    "@tanstack/react-router": "^1.170.35",
    "@tanstack/react-start": "^1.168.52",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "srvx": "^1.0.4"
  },
  "devDependencies": {
    "@astryxdesign/build": "^0.6.0",
    "@astryxdesign/cli": "^0.6.0",
    "@babel/core": "^7.29.0",
    "@stylexjs/babel-plugin": "^0.19.0",
    "@stylexjs/unplugin": "^0.19.0",
    "@tanstack/router-cli": "^1.167.35",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.4.1",
  "agentdock": {
    "minCliVersion": "0.21.0",
    "dataLayers": [
      "sqlite",
      "supabase"
    ],
    "defaultDataLayer": "sqlite",
    "supportsSchema": false
  }
}
