{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["./tools/oxlint-agentdock.mjs"],
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "promise",
    "react",
    "react-perf",
    "jsx-a11y"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "options": {
    "typeAware": true
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": "off",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "agentdock-arch/require-feature-contract": "error",
    "agentdock-arch/no-cross-feature": "error",
    "agentdock-arch/no-core-mutation": "error"
  },
  "overrides": [
    {
      "files": ["src/features/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/infra/db/**", "**/infra/db"],
                "message": "Direct DB access in features is not allowed. Use a repository from src/core/repositories via src/infra/providers."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/routeTree.gen.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "ignorePatterns": [
    ".github/skills/**",
    "dist/**",
    ".output/**",
    "src/routeTree.gen.ts",
    "drizzle/**"
  ]
}
