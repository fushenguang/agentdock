# Fail before install when the local package-manager version does not satisfy
# engines.pnpm. The recovery paths are documented in README.md and LLM.md.
#
# Do not let an older pnpm automatically download and execute another pnpm
# version. The engine check below provides a deterministic, actionable failure
# instead of leaving a broken native executable shim behind.
manage-package-manager-versions=false
engine-strict=true
